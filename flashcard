        window.renderDeck = function() {
            const grid = document.getElementById('deck-grid');
            const counter = document.getElementById('card-count');
            const emptyState = document.getElementById('empty-state');
            const activeTitle = document.getElementById('active-deck-title');
            
            const currentDeck = window.decks[window.activeDeckId];
            activeTitle.textContent = currentDeck.name;
            counter.textContent = currentDeck.cards.length;

            if (currentDeck.cards.length === 0) {
                grid.innerHTML = '';
                grid.appendChild(emptyState);
                return;
            }

            if (emptyState) emptyState.remove();

            grid.innerHTML = currentDeck.cards.map(card => {
                const hasFrontImg = card.front.image ? `<img src="${card.front.image}" class="max-h-20 mx-auto rounded object-contain border my-1">` : '';
                const hasBackImg = card.back.image ? `<img src="${card.back.image}" class="max-h-20 mx-auto rounded object-contain border my-1">` : '';
                const hasFrontAudio = card.front.audio ? `<button onclick="playAudio('${card.front.audio}', event)" class="w-7 h-7 rounded-full bg-blue-100 text-blue-600 text-xs flex items-center justify-center"><i class="fa-solid fa-volume-high"></i></button>` : '';
                const hasBackAudio = card.back.audio ? `<button onclick="playAudio('${card.back.audio}', event)" class="w-7 h-7 rounded-full bg-blue-100 text-blue-600 text-xs flex items-center justify-center"><i class="fa-solid fa-volume-high"></i></button>` : '';

                return `
                    <div class="perspective h-64 w-full cursor-pointer" onclick="flipCard(this)">
                        <div class="preserve-3d relative w-full h-full duration-500">
                            
                            <!-- FRONT -->
                            <div class="absolute inset-0 bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md p-4 flex flex-col justify-between backface-hidden">
                                <div class="flex justify-between items-center">
                                    ${window.getDueBadge(card.dueDate)}
                                    <div class="flex gap-1.5">
                                        <button onclick="openEditModal('${card.id}', event)" class="text-slate-400 hover:text-blue-600 p-1 text-xs"><i class="fa-solid fa-pen"></i></button>
                                        <button onclick="deleteCard('${card.id}', event)" class="text-slate-400 hover:text-red-600 p-1 text-xs"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </div>
                                <div class="text-center flex-grow flex flex-col justify-center items-center px-1">
                                    ${hasFrontImg}
                                    <h4 class="text-base font-bold text-slate-800 break-words max-w-full">${card.front.text || '<span class="text-slate-300 italic">Empty</span>'}</h4>
                                </div>
                                <div class="flex justify-between items-center text-[10px] text-slate-400 border-t pt-2">
                                    <span><i class="fa-solid fa-arrows-rotate mr-1"></i>Flip</span>
                                    ${hasFrontAudio}
                                </div>
                            </div>

                            <!-- BACK -->
                            <div class="absolute inset-0 bg-slate-900 text-white rounded-2xl p-4 flex flex-col justify-between backface-hidden rotate-y-180">
                                <div class="flex justify-between items-center">
                                    <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">Definition</span>
                                    <div class="flex gap-1.5">
                                        <button onclick="openEditModal('${card.id}', event)" class="text-slate-400 hover:text-blue-400 p-1 text-xs"><i class="fa-solid fa-pen"></i></button>
                                        <button onclick="deleteCard('${card.id}', event)" class="text-slate-400 hover:text-red-400 p-1 text-xs"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </div>
                                <div class="text-center flex-grow flex flex-col justify-center items-center px-1">
                                    ${hasBackImg}
                                    <p class="text-xs font-medium text-slate-200 leading-relaxed max-h-24 overflow-y-auto break-words w-full">${card.back.text || '<span class="text-slate-500 italic">Empty</span>'}</p>
                                </div>
                                <div class="flex justify-between items-center text-[10px] text-slate-400 border-t border-slate-800 pt-2">
                                    <span><i class="fa-solid fa-arrows-rotate mr-1"></i>Flip</span>
                                    ${hasBackAudio}
                                </div>
                            </div>

                        </div>
                    </div>
                `;
            }).join('');
        };

        window.initReviewSession = function() {
            const now = new Date();
            window.isPracticeMode = false;
            
            const currentDeck = window.decks[window.activeDeckId];
            window.reviewQueue = currentDeck.cards.filter(c => new Date(c.dueDate) <= now);
            window.currentQueueIndex = 0;

            const studyContainer = document.getElementById('study-container');
            const completionScreen = document.getElementById('completion-screen');

            if (window.reviewQueue.length === 0) {
                studyContainer.classList.add('hidden');
                completionScreen.classList.remove('hidden');
                document.getElementById('session-progress').textContent = "0 of 0";
            } else {
                completionScreen.classList.add('hidden');
                studyContainer.classList.remove('hidden');
                window.loadCurrentReviewCard();
            }
        };

        window.loadCurrentReviewCard = function() {
            if (window.currentQueueIndex >= window.reviewQueue.length) {
                document.getElementById('study-container').classList.add('hidden');
                document.getElementById('completion-screen').classList.remove('hidden');
                window.updateDueCounters();
                return;
            }

            const card = window.reviewQueue[window.currentQueueIndex];
            document.getElementById('session-progress').textContent = `${window.currentQueueIndex + 1} of ${window.reviewQueue.length}`;
            
            document.getElementById('study-back-section').classList.add('hidden');
            document.getElementById('rating-buttons-box').classList.add('hidden');
            document.getElementById('show-answer-box').classList.remove('hidden');

            document.getElementById('study-text').textContent = card.front.text || '';
            const imgBox = document.getElementById('study-image-container');
            imgBox.innerHTML = card.front.image ? `<img src="${card.front.image}" class="max-h-40 mx-auto rounded-xl object-contain shadow-sm border">` : '';

            const audBox = document.getElementById('study-audio-container');
            audBox.innerHTML = card.front.audio ? `<button onclick="playAudio('${card.front.audio}')" class="px-3 py-1 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded-full text-xs font-semibold flex items-center gap-1.5 transition"><i class="fa-solid fa-volume-high"></i> Listen</button>` : '';

            document.getElementById('study-back-text').textContent = card.back.text || '';
            const backImgBox = document.getElementById('study-back-image-container');
            backImgBox.innerHTML = card.back.image ? `<img src="${card.back.image}" class="max-h-32 mx-auto rounded-xl object-contain shadow-sm border">` : '';

            const backAudBox = document.getElementById('study-back-audio-container');
            backAudBox.innerHTML = card.back.audio ? `<button onclick="playAudio('${card.back.audio}')" class="px-3 py-1 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded-full text-xs font-semibold inline-flex items-center gap-1.5 transition"><i class="fa-solid fa-volume-high"></i> Pronunciation</button>` : '';
        };

        function base64ToBlob(base64, contentType = '') {
            const sliceSize = 1024;
            const byteCharacters = atob(base64.split(',')[1] || base64);
            const byteArrays = [];

            for (let offset = 0; offset < byteCharacters.length; offset += sliceSize) {
                const slice = byteCharacters.slice(offset, offset + sliceSize);
                const byteNumbers = new Array(slice.length);
                for (let i = 0; i < slice.length; i++) {
                    byteNumbers[i] = slice.charCodeAt(i);
                }
                const byteArray = new Uint8Array(byteNumbers);
                byteArrays.push(byteArray);
            }
            return new Blob(byteArrays, { type: contentType });
        }

        window.getDueBadge = function(dueDateStr) {
            const now = new Date();
            const due = new Date(dueDateStr);
            const diffHours = (due - now) / (1000 * 60 * 60);

            if (diffHours <= 0) {
                return `<span class="bg-red-50 text-red-600 border border-red-100 text-[10px] font-bold px-2 py-0.5 rounded-full"><i class="fa-solid fa-bell mr-1"></i>Due Today</span>`;
            } else if (diffHours <= 24) {
                return `<span class="bg-amber-50 text-amber-700 border border-amber-100 text-[10px] font-bold px-2 py-0.5 rounded-full"><i class="fa-regular fa-clock mr-1"></i>Due Tomorrow</span>`;
            } else {
                const days = Math.ceil(diffHours / 24);
                return `<span class="bg-emerald-50 text-emerald-700 border border-emerald-100 text-[10px] font-bold px-2 py-0.5 rounded-full"><i class="fa-solid fa-shield-halved mr-1"></i>In ${days} days</span>`;
            }
        };

        window.clearSingleForm = function() {
            document.getElementById('front-text').value = '';
            document.getElementById('back-text').value = '';
            document.getElementById('front-image-file').value = '';
            document.getElementById('back-image-file').value = '';
            document.getElementById('front-audio-file').value = '';
            document.getElementById('back-audio-file').value = '';
            document.getElementById('front-image-label').textContent = 'Upload Photo';
            document.getElementById('back-image-label').textContent = 'Upload Photo';
            document.getElementById('front-audio-label').textContent = 'Upload Audio';
            document.getElementById('back-audio-label').textContent = 'Upload Audio';
            window.tempMedia = { frontImage: '', frontAudio: '', backImage: '', backAudio: '' };
        };
    </script>
</body>
