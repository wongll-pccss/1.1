<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English Flashcard Studio - Spaced Repetition Portal</title>
    <!-- Tailwind CSS for modern responsive styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for clean icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></link>
    <!-- JSZip Library for generating client-side .apkg files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- Firebase SDK v9 Compatibility Imports -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

    <style>
        .perspective { perspective: 1000px; }
        .preserve-3d { transform-style: preserve-3d; transition: transform 0.5s ease; }
        .flipped { transform: rotateY(180deg); }
        .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans text-slate-800 pb-16">

    <!-- Top Navigation Header -->
    <header class="bg-blue-600 text-white shadow-md py-4 px-4 sticky top-0 z-40">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-graduation-cap text-3xl"></i>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">English Flashcard Studio</h1>
                    <p class="text-xs text-blue-100">Spaced Repetition Portal</p>
                </div>
            </div>

            <!-- View switcher and Auth actions -->
            <div class="flex flex-wrap items-center gap-2">
                <!-- Navigation Switchers -->
                <div class="flex items-center bg-blue-700/80 p-1 rounded-xl gap-1 mr-2">
                    <button id="nav-review" onclick="switchView('review')" class="py-2 px-3 rounded-lg font-semibold text-xs transition bg-white text-blue-700 shadow-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-clock-rotate-left"></i> Review Due
                        <span id="due-counter-badge" class="bg-emerald-400 text-slate-900 text-[10px] font-extrabold px-1.5 py-0.5 rounded-full">0</span>
                    </button>
                    <button id="nav-studio" onclick="switchView('studio')" class="py-2 px-3 rounded-lg font-semibold text-xs transition text-white hover:bg-blue-600 flex items-center gap-1.5">
                        <i class="fa-solid fa-layer-group"></i> Teacher Mode
                    </button>
                </div>

                <!-- Google Auth UI elements -->
                <div id="auth-status" class="text-xs font-semibold">
                    <button onclick="signInWithGoogle()" class="bg-white text-slate-700 hover:bg-slate-100 py-2 px-3 rounded-lg flex items-center gap-1.5 transition shadow-sm">
                        <i class="fa-brands fa-google text-red-500"></i> Sign In with Google
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ==================== SIGN-IN WALL FOR STUDENTS ==================== -->
    <div id="signin-wall" class="max-w-md mx-auto mt-20 px-4 text-center">
        <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-md">
            <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto text-2xl mb-4">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">Student Study Portal</h2>
            <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
                Please sign in with your school Google account to load your personalized decks and save your spaced repetition progress.
            </p>
            <button onclick="signInWithGoogle()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition text-sm flex items-center justify-center gap-2">
                <i class="fa-brands fa-google text-red-400"></i> Sign In with Google
            </button>
        </div>
    </div>

    <!-- MAIN APP WRAPPER (HIDDEN UNTIL AUTHENTICATED) -->
    <div id="main-content-app" class="hidden mt-6">

        <!-- ==================== VIEW 1: STUDY COMPONENT (DEFAULT HOME PAGE) ==================== -->
        <main id="view-review" class="max-w-2xl mx-auto px-4">
            
            <!-- Review Summary Bar -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 mb-6 flex flex-wrap justify-between items-center gap-3">
                <div>
                    <!-- Active Deck Select in Study Mode -->
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-0.5">Study Deck</label>
                    <select id="review-deck-select" onchange="handleReviewDeckChange()" class="px-3 py-1.5 border border-slate-200 rounded-lg text-xs bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none font-bold">
                        <!-- Dynamically Loaded Decks -->
                    </select>
                </div>
                <div class="text-right flex flex-col items-end gap-1">
                    <span id="session-progress" class="text-xs font-bold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">0 of 0</span>
                    <span id="review-subtitle" class="text-[10px] text-slate-400 font-medium">Spaced Repetition Scheduler</span>
                </div>
            </div>

            <!-- ACTIVE CARD STUDY CONTAINER -->
            <div id="study-container" class="relative">
                
                <!-- Flashcard Display Box -->
                <div class="bg-white rounded-3xl shadow-md border border-slate-100 min-h-[380px] p-8 flex flex-col justify-between text-center relative overflow-hidden transition-all duration-300">
                    
                    <!-- Card Meta Header -->
                    <div class="flex justify-between items-center text-xs border-b pb-3 border-slate-100">
                        <span id="study-panel-label" class="font-bold uppercase tracking-wider text-blue-500 bg-blue-50 px-2.5 py-1 rounded-full text-[10px]">Front Prompt</span>
                        <div id="study-audio-container"></div>
                    </div>

                    <!-- Main Card Body -->
                    <div class="my-auto py-6 flex flex-col items-center justify-center">
                        <div id="study-image-container" class="mb-4"></div>
                        <div id="study-text" class="text-2xl font-bold text-slate-800 break-words max-w-full"></div>
                        
                        <!-- Back Answer Section (Hidden until revealed) -->
                        <div id="study-back-section" class="hidden mt-6 pt-6 border-t border-slate-100 w-full animate-in fade-in duration-300">
                            <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-600 bg-emerald-5  px-2 py-0.5 rounded-full inline-block mb-3">Answer / Definition</span>
                            <div id="study-back-image-container" class="mb-3"></div>
                            <div id="study-back-text" class="text-base text-slate-600 font-medium leading-relaxed max-w-lg mx-auto"></div>
                            <div id="study-back-audio-container" class="mt-3"></div>
                        </div>
                    </div>

                    <!-- Bottom Trigger: Show Answer Button -->
                    <div id="show-answer-box" class="pt-4 border-t border-slate-100">
                        <button onclick="revealAnswer()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition text-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-eye"></i> Show Answer
                        </button>
                    </div>

                    <!-- Bottom Trigger: 4-Scale SM-2 Rating Buttons -->
                    <div id="rating-buttons-box" class="hidden pt-4 border-t border-slate-100">
                        <p class="text-[11px] text-slate-400 mb-2 font-medium">How easily did you recall this?</p>
                        <div class="grid grid-cols-4 gap-2">
                            <button onclick="handleRating(1)" class="flex flex-col items-center justify-center py-2.5 px-1 rounded-xl border border-red-200 bg-red-50 hover:bg-red-100 text-red-700 transition">
                                <span class="text-xs font-bold">Again</span>
                                <span class="text-[10px] opacity-75 mt-0.5">&lt; 1 day</span>
                            </button>
                            <button onclick="handleRating(3)" class="flex flex-col items-center justify-center py-2.5 px-1 rounded-xl border border-amber-200 bg-amber-50 hover:bg-amber-100 text-amber-700 transition">
                                <span class="text-xs font-bold">Hard</span>
                                <span class="text-[10px] opacity-75 mt-0.5">1-2 days</span>
                            </button>
                            <button onclick="handleRating(4)" class="flex flex-col items-center justify-center py-2.5 px-1 rounded-xl border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 transition">
                                <span class="text-xs font-bold">Good</span>
                                <span class="text-[10px] opacity-75 mt-0.5">3-6 days</span>
                            </button>
                            <button onclick="handleRating(5)" class="flex flex-col items-center justify-center py-2.5 px-1 rounded-xl border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 transition">
                                <span class="text-xs font-bold">Easy</span>
                                <span class="text-[10px] opacity-75 mt-0.5">&gt; 7 days</span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>

            <!-- COMPLETION SCREEN -->
            <div id="completion-screen" class="bg-white rounded-3xl shadow-sm border border-slate-100 p-12 text-center hidden">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl mb-4">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">All caught up!</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
                    All scheduled reviews for this deck have been completed. Study again tomorrow!
                </p>
                <div class="flex flex-wrap justify-center gap-3">
                    <button onclick="startPracticeAll()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2.5 rounded-xl text-xs transition shadow-sm">
                        <i class="fa-solid fa-dumbbell mr-1"></i> Practice All Cards Anyway
                    </button>
                </div>
            </div>

        </main>

        <!-- ==================== VIEW 2: TEACHER STUDIO (DECK CREATOR, CARD CREATOR & LIST) ==================== -->
        <main id="view-studio" class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-8 hidden">
            
            <!-- LEFT COLUMN: DECK SELECTOR & CARD CREATORS (5 cols) -->
            <section class="lg:col-span-5 flex flex-col gap-5">
                
                <!-- DECK CREATION & SELECTION MANAGEMENT -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-4">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-folder-closed text-blue-600"></i> Deck Management
                    </h2>
                    
                    <!-- Deck Selector Dropdown -->
                    <div>
                        <label class="block text-[11px] font-medium text-slate-600 mb-1">Select Active Studio Deck</label>
                        <div class="flex gap-2">
                            <select id="deck-select" onchange="handleDeckSelectionChange()" class="flex-1 px-3 py-2 border border-slate-200 rounded-lg text-xs bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                <!-- Dynamically Loaded -->
                            </select>
                            <button onclick="deleteCurrentDeck()" class="text-red-500 hover:text-red-700 p-2 border border-slate-200 hover:bg-red-50 rounded-lg transition" title="Delete current deck">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <hr class="border-slate-100">

                    <!-- Quick Deck Creation Input -->
                    <div>
                        <label class="block text-[11px] font-medium text-slate-600 mb-1">Create New Vocabulary Deck</label>
                        <div class="flex gap-2">
                            <input type="text" id="new-deck-name" placeholder="e.g. Unit 1 Vocab" class="flex-1 px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs">
                            <button onclick="createNewDeck()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 rounded-lg text-xs transition shadow-sm flex items-center gap-1">
                                <i class="fa-solid fa-folder-plus"></i> Create
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Tab Switcher (Card Inputs) -->
                <div class="bg-white rounded-xl shadow-sm p-1.5 flex gap-1">
                    <button id="tab-single" onclick="switchTab('single')" class="flex-1 py-2 px-3 rounded-lg font-medium text-xs transition bg-blue-600 text-white shadow-sm">
                        <i class="fa-solid fa-plus mr-1"></i>Create Single Card
                    </button>
                    <button id="tab-bulk" onclick="switchTab('bulk')" class="flex-1 py-2 px-3 rounded-lg font-medium text-xs transition text-slate-600 hover:bg-slate-100">
                        <i class="fa-solid fa-file-import mr-1"></i>Paste Excel / CSV
                    </button>
                </div>

                <!-- Single Card Creator Form -->
                <div id="form-single" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-4">
                    <h2 class="text-sm font-bold text-slate-900 border-b pb-2 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-blue-600"></i> New Card Information
                    </h2>

                    <!-- Front Side -->
                    <div class="space-y-2.5">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Front Panel (Word / Prompt)</h3>
                        <div>
                            <input type="text" id="front-text" placeholder="e.g. Persevere" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 text-xs">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[11px]">
                                <i class="fa-solid fa-image text-slate-400 mb-1"></i>
                                <span id="front-image-label" class="text-slate-500 truncate max-w-[120px]">Upload Photo</span>
                                <input type="file" id="front-image-file" accept="image/*" onchange="handleImageUpload(this, 'front')" class="hidden">
                            </label>
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[11px]">
                                <i class="fa-solid fa-microphone text-slate-400 mb-1"></i>
                                <span id="front-audio-label" class="text-slate-500 truncate max-w-[120px]">Upload Audio</span>
                                <input type="file" id="front-audio-file" accept="audio/*" onchange="handleAudioUpload(this, 'front')" class="hidden">
                            </label>
                        </div>
                    </div>

                    <hr class="border-slate-100">

                    <!-- Back Side -->
                    <div class="space-y-2.5">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Back Panel (Definition / Notes)</h3>
                        <div>
                            <textarea id="back-text" rows="2" placeholder="e.g. Continue in a course of action even in the face of difficulty (verb)" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 text-xs resize-none"></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[11px]">
                                <i class="fa-solid fa-image text-slate-400 mb-1"></i>
                                <span id="back-image-label" class="text-slate-500 truncate max-w-[120px]">Upload Photo</span>
                                <input type="file" id="back-image-file" accept="image/*" onchange="handleImageUpload(this, 'back')" class="hidden">
                            </label>
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[11px]">
                                <i class="fa-solid fa-microphone text-slate-400 mb-1"></i>
                                <span id="back-audio-label" class="text-slate-500 truncate max-w-[120px]">Upload Audio</span>
                                <input type="file" id="back-audio-file" accept="audio/*" onchange="handleAudioUpload(this, 'back')" class="hidden">
                            </label>
                        </div>
                    </div>

                    <button onclick="addSingleCard()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition shadow-sm text-xs flex items-center justify-center gap-2 mt-1">
                        <i class="fa-solid fa-plus-circle"></i> Add to Selected Deck
                    </button>
                </div>

                <!-- Bulk Importer (Paste Zone) -->
                <div id="form-bulk" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col gap-3.5 hidden">
                    <h2 class="text-sm font-bold text-slate-900 border-b pb-2 flex items-center gap-2">
                        <i class="fa-solid fa-file-csv text-emerald-600"></i> Excel / CSV Bulk Importer
                    </h2>
                    <p class="text-[11px] text-slate-500">
                        Paste rows copied directly from Excel or Google Sheets. Format: <strong>Front Text</strong> separated by a tab or comma from <strong>Back Text</strong>.
                    </p>
                    <textarea id="bulk-paste" rows="7" placeholder="Accomplish&#x9;To achieve something successfully&#10;Acquisition&#x9;The learning of a skill&#10;Inherent&#x9;Existing as a permanent attribute" class="w-full font-mono text-xs px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 resize-none"></textarea>
                    <button onclick="importBulkCards()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-lg transition shadow-sm text-xs flex items-center justify-center gap-2">
                        <i class="fa-solid fa-bolt"></i> Process and Import Rows
                    </button>
                </div>

            </section>

            <!-- RIGHT COLUMN: DECK OVERVIEW (7 cols) -->
            <section class="lg:col-span-7 flex flex-col gap-5">
                
                <!-- Controls bar -->
                <div class="bg-white rounded-xl shadow-sm p-4 flex flex-wrap justify-between items-center gap-3">
                    <div>
                        <h2 class="font-bold text-slate-900 text-sm">Deck Collection: <span id="active-deck-title" class="text-blue-600">Default Deck</span></h2>
                        <p class="text-xs text-slate-500"><span id="card-count" class="font-bold text-blue-600">0</span> total flashcards</p>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <button onclick="exportAnkiAPKG()" class="bg-slate-900 text-white hover:bg-slate-800 text-xs font-semibold py-2 px-3 rounded-lg shadow-sm transition flex items-center gap-1.5">
                            <i class="fa-solid fa-box-archive text-blue-400"></i> Export .apkg
                        </button>
                        <button onclick="exportCSV()" class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold py-2 px-3 rounded-lg shadow-sm transition flex items-center gap-1.5">
                            <i class="fa-solid fa-download text-slate-400"></i> Export CSV
                        </button>
                        <button onclick="clearCurrentDeckCards()" class="bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold py-2 px-3 rounded-lg transition flex items-center gap-1.5">
                            <i class="fa-solid fa-trash-can"></i> Clear Cards
                        </button>
                    </div>
                </div>

                <!-- Flashcards Grid -->
                <div id="deck-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div id="empty-state" class="col-span-full bg-white border border-dashed border-slate-200 rounded-2xl p-12 text-center text-slate-400">
                        <i class="fa-solid fa-box-open text-4xl mb-3 text-slate-300"></i>
                        <p class="text-sm font-medium">This deck is currently empty</p>
                        <p class="text-xs text-slate-400 mt-1">Create cards on the left panel to fill this specific deck.</p>
                    </div>
                </div>

            </section>

        </main>

    </div>

    <!-- Interactive Card Editor Modal with Media Uploads -->
    <div id="edit-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl border w-full max-w-lg overflow-hidden animate-in fade-in duration-200">
            <div class="bg-slate-900 text-white px-6 py-4 flex justify-between items-center">
                <h3 class="font-bold text-sm flex items-center gap-2"><i class="fa-solid fa-edit text-blue-400"></i> Edit Flashcard</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-white transition"><i class="fa-solid fa-times text-base"></i></button>
            </div>
            <div class="p-6 flex flex-col gap-4 max-h-[80vh] overflow-y-auto">
                <input type="hidden" id="edit-card-id">
                
                <!-- FRONT PANEL EDIT -->
                <div class="space-y-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-blue-500 bg-blue-50 px-2 py-0.5 rounded-full">Front Panel</span>
                    <div>
                        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Word / Prompt Text</label>
                        <input type="text" id="edit-front-text" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[10px] font-medium text-slate-500 mb-1">Upload Photo</label>
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[10px]">
                                <i class="fa-solid fa-image text-slate-400 mb-0.5"></i>
                                <span id="edit-front-image-label" class="text-slate-500 truncate max-w-[120px]">Change Image</span>
                                <input type="file" id="edit-front-image-file" accept="image/*" onchange="handleEditMediaUpload(this, 'front', 'Image')" class="hidden">
                            </label>
                            <button id="btn-remove-front-image" onclick="removeEditMedia('front', 'Image')" class="hidden mt-1 text-[10px] text-red-500 hover:underline flex items-center gap-1"><i class="fa-solid fa-trash"></i> Remove Image</button>
                        </div>
                        <div>
                            <label class="block text-[10px] font-medium text-slate-500 mb-1">Upload Audio</label>
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[10px]">
                                <i class="fa-solid fa-microphone text-slate-400 mb-0.5"></i>
                                <span id="edit-front-audio-label" class="text-slate-500 truncate max-w-[120px]">Change Audio</span>
                                <input type="file" id="edit-front-audio-file" accept="audio/*" onchange="handleEditMediaUpload(this, 'front', 'Audio')" class="hidden">
                            </label>
                            <button id="btn-remove-front-audio" onclick="removeEditMedia('front', 'Audio')" class="hidden mt-1 text-[10px] text-red-500 hover:underline flex items-center gap-1"><i class="fa-solid fa-trash"></i> Remove Audio</button>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100">

                <!-- BACK PANEL EDIT -->
                <div class="space-y-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Back Panel</span>
                    <div>
                        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Definition / Answers</label>
                        <textarea id="edit-back-text" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs resize-none"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[10px] font-medium text-slate-500 mb-1">Upload Photo</label>
                            <label class="flex flex-col items-center justify-center border border-dashed border-slate-300 rounded-lg p-2 hover:bg-slate-50 cursor-pointer text-[10px]">
                                <i class="fa-solid fa-image text-slate-400 mb-0.5"></i>
