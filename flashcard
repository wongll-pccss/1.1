        window.handleRating = function(quality) {
            const currentCard = window.reviewQueue[window.currentQueueIndex];
            const realDeckCard = window.decks[window.activeDeckId].cards.find(c => c.id === currentCard.id);

            if (realDeckCard && !window.isPracticeMode) {
                let ef = realDeckCard.easiness || 2.5;
                let reps = realDeckCard.repetitions || 0;
                let interval = realDeckCard.interval || 0;

                ef = ef + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02));
                if (ef < 1.3) ef = 1.3;
                realDeckCard.easiness = Number(ef.toFixed(2));

                if (quality < 3) {
                    reps = 0;
                    interval = 1;
                } else {
                    if (reps === 0) {
                        interval = 1;
                    } else if (reps === 1) {
                        interval = (quality === 3) ? 2 : (quality === 5 ? 6 : 4);
                    } else {
                        const bonus = (quality === 5) ? 1.3 : 1.0;
                        interval = Math.round(interval * realDeckCard.easiness * bonus);
                    }
                    reps += 1;
                }

                realDeckCard.repetitions = reps;
                realDeckCard.interval = interval;

                const nextDueDate = new Date();
                nextDueDate.setDate(nextDueDate.getDate() + interval);
                realDeckCard.dueDate = nextDueDate.toISOString();
                realDeckCard.lastReviewed = new Date().toISOString();

                window.saveToStorage();
            }

            window.currentQueueIndex++;
            window.loadCurrentReviewCard();
        };

        window.exportCSV = function() {
            const currentDeck = window.decks[window.activeDeckId];
            if (currentDeck.cards.length === 0) {
                alert("Nothing to export yet.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Front Text,Back Text,Front Image (Base64),Front Audio (Base64),Back Image (Base64),Back Audio (Base64)\r\n";

            currentDeck.cards.forEach(card => {
                const fText = `"${(card.front.text || '').replace(/"/g, '""')}"`;
                const bText = `"${(card.back.text || '').replace(/"/g, '""')}"`;
                const fImg = `"${card.front.image || ''}"`;
                const fAud = `"${card.front.audio || ''}"`;
                const bImg = `"${card.back.image || ''}"`;
                const bAud = `"${card.back.audio || ''}"`;
                csvContent += `${fText},${bText},${fImg},${fAud},${bImg},${bAud}\r\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `${currentDeck.name.toLowerCase().replace(/\s+/g, '_')}_cards.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.exportAnkiAPKG = function() {
            const currentDeck = window.decks[window.activeDeckId];
            if (currentDeck.cards.length === 0) {
                alert("This deck has no cards to export.");
                return;
            }

            const zip = new JSZip();
            const mediaFiles = [];
            const notes = [];

            currentDeck.cards.forEach((card, i) => {
                let front = card.front.text || "";
                let back = card.back.text || "";

                if (card.front.image) {
                    const filename = `img_front_${i}.png`;
                    mediaFiles.push({ filename, data: card.front.image });
                    front += `<br><img src="${filename}">`;
                }
                if (card.front.audio) {
                    const filename = `aud_front_${i}.mp3`;
                    mediaFiles.push({ filename, data: card.front.audio });
                    front += `[sound:${filename}]`;
                }
                if (card.back.image) {
                    const filename = `img_back_${i}.png`;
                    mediaFiles.push({ filename, data: card.back.image });
                    back += `<br><img src="${filename}">`;
                }
                if (card.back.audio) {
                    const filename = `aud_back_${i}.mp3`;
                    mediaFiles.push({ filename, data: card.back.audio });
                    back += `[sound:${filename}]`;
                }
                notes.push(`${front}\t${back}`);
            });

            const mediaJSON = {};
            mediaFiles.forEach((file, i) => {
                mediaJSON[i] = file.filename;
                const blob = base64ToBlob(file.data);
                zip.file(file.filename, blob);
            });
            zip.file("media", JSON.stringify(mediaJSON));
            zip.file("notes.txt", notes.join("\n"));
            
            zip.generateAsync({ type: "blob" }).then(function(content) {
                const link = document.createElement("a");
                link.href = URL.createObjectURL(content);
                link.download = `${currentDeck.name.replace(/\s+/g, '_')}.apkg`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        };

